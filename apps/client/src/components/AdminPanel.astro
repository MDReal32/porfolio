<!-- Hidden trigger: Konami code (↑↑↓↓←→←→ b a) drops this panel open, right between the nav and the page -->
<div
  id="admin-panel"
  class="grid grid-rows-[0fr] overflow-hidden px-6 transition-[grid-template-rows] duration-300 ease-out print:hidden"
>
  <div class="overflow-hidden">
    <div
      id="admin-panel-inner"
      class="border-base-300/60 mx-auto flex max-w-2xl flex-wrap items-center gap-2 border-b py-4 opacity-0 transition-opacity delay-100 duration-300 ease-out"
    >
      <button
        type="button"
        data-role="frontend"
        class="border-base-300/50 text-base-content/70 hover:border-primary/60 hover:text-base-content rounded-full border px-3 py-1 text-xs transition"
      >
        Frontend
      </button>
      <button
        type="button"
        data-role="backend"
        class="border-base-300/50 text-base-content/70 hover:border-primary/60 hover:text-base-content rounded-full border px-3 py-1 text-xs transition"
      >
        Backend
      </button>
      <button
        type="button"
        data-role="devops"
        class="border-base-300/50 text-base-content/70 hover:border-primary/60 hover:text-base-content rounded-full border px-3 py-1 text-xs transition"
      >
        DevOps
      </button>
      <!-- Kept in sync with the "active" toggle classes below so Tailwind's scanner picks them up -->
      <span class="bg-primary text-primary-content border-primary hidden"></span>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const STORAGE_KEY = "portfolio:admin";
    const ROLE_KEY = "portfolio:resumeRole";
    const SEQUENCE = ["ArrowUp", "ArrowUp", "ArrowDown", "ArrowDown", "ArrowLeft", "ArrowRight", "ArrowLeft", "ArrowRight", "b", "a"];
    const ARROWS = ["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight"];
    const MAX_KEY_GAP_MS = 3000;
    let step = 0;
    let lastKeyAt = 0;

    const isAdmin = () => localStorage.getItem(STORAGE_KEY) === "true";
    const getRole = () => localStorage.getItem(ROLE_KEY);

    function render() {
      const panel = document.getElementById("admin-panel");
      const inner = document.getElementById("admin-panel-inner");
      if (!panel || !inner) return;
      const open = isAdmin();
      panel.classList.toggle("grid-rows-[1fr]", open);
      panel.classList.toggle("grid-rows-[0fr]", !open);
      inner.classList.toggle("opacity-100", open);
      inner.classList.toggle("opacity-0", !open);
    }

    function isVisibleForRole(el, role) {
      const roles = el.getAttribute("data-roles");
      return !role || !roles || roles.split(" ").includes(role);
    }

    // Elements elsewhere on the page (skills, experience, projects) tagged with data-roles.
    // animate=false on initial load so a stored filter applies instantly, with no flash/shift.
    function applyRoleFilter(animate) {
      const role = getRole();
      document.querySelectorAll("[data-roles]").forEach(el => {
        const show = isVisibleForRole(el, role);

        if (!animate) {
          el.classList.toggle("hidden", !show);
          el.classList.toggle("opacity-0", !show);
          el.classList.toggle("scale-95", !show);
          return;
        }

        el.classList.add("transition-all", "duration-300", "ease-out");
        if (show) {
          el.classList.remove("hidden");
          void el.offsetWidth; // force reflow so the transition plays
          el.classList.remove("opacity-0", "scale-95");
        } else {
          el.classList.add("opacity-0", "scale-95");
          window.setTimeout(() => {
            if (!isVisibleForRole(el, getRole())) el.classList.add("hidden");
          }, 300);
        }
      });
    }

    function renderRoleButtons() {
      const role = getRole();
      document.querySelectorAll("#admin-panel-inner [data-role]").forEach(btn => {
        const active = btn.getAttribute("data-role") === role;
        btn.classList.toggle("bg-primary", active);
        btn.classList.toggle("text-primary-content", active);
        btn.classList.toggle("border-primary", active);
        btn.classList.toggle("text-base-content/70", !active);
      });
    }

    function onRoleButtonClick(e) {
      const role = e.currentTarget.getAttribute("data-role");
      if (getRole() === role) {
        localStorage.removeItem(ROLE_KEY);
      } else {
        localStorage.setItem(ROLE_KEY, role);
      }
      applyRoleFilter(true);
      renderRoleButtons();
    }

    function onKeydown(e) {
      if (ARROWS.includes(e.key)) e.preventDefault();

      const now = Date.now();
      if (now - lastKeyAt > MAX_KEY_GAP_MS) step = 0;
      lastKeyAt = now;

      if (e.key === SEQUENCE[step]) {
        step++;
        if (step === SEQUENCE.length) {
          step = 0;
          localStorage.setItem(STORAGE_KEY, isAdmin() ? "false" : "true");
          render();
        }
      } else {
        step = e.key === SEQUENCE[0] ? 1 : 0;
      }
    }

    function onAnyClick() {
      step = 0;
    }

    function init() {
      render();
      applyRoleFilter(false);
      renderRoleButtons();

      document.removeEventListener("keydown", onKeydown);
      document.addEventListener("keydown", onKeydown);

      document.removeEventListener("click", onAnyClick);
      document.addEventListener("click", onAnyClick);

      document.querySelectorAll("#admin-panel-inner [data-role]").forEach(btn => {
        btn.addEventListener("click", onRoleButtonClick);
      });
    }

    init();
    document.addEventListener("astro:page-load", init);
  })();
</script>
