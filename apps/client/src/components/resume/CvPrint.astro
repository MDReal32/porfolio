---
import { portfolio } from "@portfolio/data";
import { formatRange, formatFullDate } from "../../utils/formatDate";
import { getContacts, getSkillLines, pubHref, splitAuthors } from "../../utils/resume";

const {
  basics,
  education = [],
  skills,
  publications = [],
  research = [],
  presentations = [],
  teaching = [],
  awards = [],
  certifications = [],
  memberships = [],
  references = []
} = portfolio;

const contacts = getContacts(basics);
const skillLines = getSkillLines(skills);

const details = [
  basics.dateOfBirth ? `Date of birth: ${formatFullDate(basics.dateOfBirth)}` : null,
  basics.nationality ? `Nationality: ${basics.nationality}` : null,
  basics.gender ? `Gender: ${basics.gender}` : null,
  basics.address ? `Address: ${basics.address}` : null
].filter((d): d is string => d !== null);
---

<article class="resume-print hidden bg-white print:block">
  <!-- Personal information -->
  <header class="text-center">
    <h1 class="resume-name">{basics.fullName}</h1>
    <p class="mt-1">
      {
        contacts.map((c, i) => (
          <>
            {i > 0 && <span class="mx-1.5 text-black/40">|</span>}
            <a href={c.href}>{c.text}</a>
          </>
        ))
      }
    </p>
    {details.length > 0 && <p class="mt-0.5">{details.join("  ·  ")}</p>}
  </header>

  {
    education.length > 0 && (
      <section class="mt-3">
        <h2 class="resume-h2">Education</h2>
        <div class="space-y-2">
          {education.map(e => (
            <div class="entry">
              <div class="flex items-baseline justify-between gap-4">
                <span class="font-bold">{e.school}</span>
                {e.location && <span class="whitespace-nowrap">{e.location}</span>}
              </div>
              <div class="flex items-baseline justify-between gap-4 italic">
                <span>{e.program}</span>
                <span class="whitespace-nowrap">{formatRange(e.start, e.end)}</span>
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    research.length > 0 && (
      <section class="mt-3">
        <h2 class="resume-h2">Research Experience</h2>
        <div class="space-y-2">
          {research.map(r => (
            <div class="entry">
              <div class="flex items-baseline justify-between gap-4">
                <span class="font-bold">{r.role}</span>
                <span class="whitespace-nowrap">{formatRange(r.start, r.end)}</span>
              </div>
              <div class="flex items-baseline justify-between gap-4 italic">
                <span>{r.organization}</span>
                {r.location && <span class="whitespace-nowrap">{r.location}</span>}
              </div>
              {r.highlights?.length ? (
                <ul class="resume-bullets">
                  {r.highlights.map(h => (
                    <li>{h}</li>
                  ))}
                </ul>
              ) : null}
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    publications.length > 0 && (
      <section class="mt-3">
        <h2 class="resume-h2">Publications</h2>
        <ol class="resume-pubs">
          {publications.map(p => {
            const [before, self, after] = splitAuthors(p);
            const href = pubHref(p);
            return (
              <li class="entry">
                {before}
                {self && <span class="font-bold">{self}</span>}
                {after} ({p.year}). <span class="italic">{p.title}.</span> {p.venue}.
                {href && (
                  <>
                    {" "}
                    <a href={href}>{p.doi ? `https://doi.org/${p.doi}` : p.url}</a>
                  </>
                )}
              </li>
            );
          })}
        </ol>
      </section>
    )
  }

  {
    presentations.length > 0 && (
      <section class="mt-3">
        <h2 class="resume-h2">Presentations</h2>
        <div class="space-y-1">
          {presentations.map(p => (
            <p class="entry">
              <span class="italic">{p.title}.</span> {p.event}
              {p.location ? `, ${p.location}` : ""}. {p.date}.
            </p>
          ))}
        </div>
      </section>
    )
  }

  {
    teaching.length > 0 && (
      <section class="mt-3">
        <h2 class="resume-h2">Teaching Experience</h2>
        <div class="space-y-2">
          {teaching.map(t => (
            <div class="entry flex items-baseline justify-between gap-4">
              <span>
                <span class="font-bold">{t.role}</span>
                {t.course ? ` — ${t.course}` : ""}, <span class="italic">{t.institution}</span>
              </span>
              <span class="whitespace-nowrap">{formatRange(t.start, t.end)}</span>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    awards.length > 0 && (
      <section class="mt-3">
        <h2 class="resume-h2">Awards &amp; Grants</h2>
        <div class="space-y-1">
          {awards.map(a => (
            <p class="entry">
              <span class="font-bold">{a.name}</span>
              {a.issuer ? `, ${a.issuer}` : ""}
              {a.amount ? ` (${a.amount})` : ""} — {a.year}
            </p>
          ))}
        </div>
      </section>
    )
  }

  {
    certifications.length > 0 && (
      <section class="mt-3">
        <h2 class="resume-h2">Certifications</h2>
        <div class="space-y-1">
          {certifications.map(c => (
            <p class="entry">
              <span class="font-bold">{c.name}</span>
              {c.issuer ? `, ${c.issuer}` : ""}
              {c.year ? ` — ${c.year}` : ""}
            </p>
          ))}
        </div>
      </section>
    )
  }

  {
    memberships.length > 0 && (
      <section class="mt-3">
        <h2 class="resume-h2">Professional Memberships</h2>
        <div class="space-y-1">
          {memberships.map(m => (
            <p class="entry">
              <span class="font-bold">{m.organization}</span>
              {m.role ? `, ${m.role}` : ""}
              {m.since ? ` (since ${m.since})` : ""}
            </p>
          ))}
        </div>
      </section>
    )
  }

  {
    skillLines.length > 0 && (
      <section class="mt-3">
        <h2 class="resume-h2">Skills</h2>
        <div class="space-y-0.5">
          {skillLines.map(s => (
            <p class="entry">
              <span class="font-bold">{s.label}</span>: {s.items.join(", ")}
            </p>
          ))}
        </div>
      </section>
    )
  }

  <section class="mt-3">
    <h2 class="resume-h2">References</h2>
    {
      references.length > 0 ? (
        <div class="space-y-1">
          {references.map(r => (
            <p class="entry">
              <span class="font-bold">{r.name}</span>
              {r.title || r.affiliation ? `, ${[r.title, r.affiliation].filter(Boolean).join(", ")}` : ""}
              {r.email ? ` — ${r.email}` : ""}
            </p>
          ))}
        </div>
      ) : (
        <p class="entry">Available upon request.</p>
      )
    }
  </section>
</article>
