---
import { portfolio } from "@portfolio/data";
import { formatRange, formatFullDate } from "../../utils/formatDate";
import { getContacts, getSkillLines, pubHref, rolesAttr, splitAuthors } from "../../utils/resume";
import PrintButton from "../PrintButton.astro";

const {
  basics,
  education = [],
  skills,
  publications = [],
  research = [],
  presentations = [],
  teaching = [],
  awards = [],
  certifications = [],
  memberships = [],
  references = []
} = portfolio;

const contacts = getContacts(basics, { academic: true });
const skillLines = getSkillLines(skills);

const details = [
  basics.dateOfBirth ? { label: "Date of birth", value: formatFullDate(basics.dateOfBirth) } : null,
  basics.placeOfBirth ? { label: "Place of birth", value: basics.placeOfBirth } : null,
  basics.nationality ? { label: "Nationality", value: basics.nationality } : null,
  basics.gender ? { label: "Gender", value: basics.gender } : null,
  basics.address ? { label: "Address", value: basics.address } : null
].filter((d): d is { label: string; value: string } => d !== null);
---

<main class="mx-auto max-w-3xl px-6 py-14 print:hidden">
  <!-- Personal information -->
  <header class="flex items-start justify-between gap-5">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
      {
        basics.avatar && (
          <img
            src={basics.avatar}
            alt={basics.fullName}
            width="80"
            height="80"
            class="ring-base-300/60 h-20 w-20 shrink-0 rounded-full object-cover ring-1"
          />
        )
      }
      <div class="space-y-1">
        <h1 class="text-3xl font-bold tracking-tight">{basics.fullName}</h1>
        <p class="text-base-content/70">{basics.title}</p>
        <p class="text-base-content/45 text-sm">{basics.location}</p>
      </div>
    </div>

    <PrintButton />
  </header>

  {
    details.length > 0 && (
      <dl class="mt-6 grid grid-cols-1 gap-x-8 gap-y-1 text-sm sm:grid-cols-2">
        {details.map(d => (
          <div class="flex gap-2">
            <dt class="text-base-content/45 w-28 shrink-0">{d.label}</dt>
            <dd class="text-base-content/75">{d.value}</dd>
          </div>
        ))}
      </dl>
    )
  }

  <div class="mt-4 flex flex-wrap gap-2">
    {
      contacts.map(c => (
        <a
          href={c.href}
          target={c.href.startsWith("http") ? "_blank" : undefined}
          rel={c.href.startsWith("http") ? "noreferrer" : undefined}
          class="border-base-300/60 text-base-content/70 hover:border-primary/60 hover:text-base-content rounded-full border px-3 py-1 text-xs transition"
        >
          {c.label}
        </a>
      ))
    }
  </div>

  <!-- Education -->
  {
    education.length > 0 && (
      <section class="mt-12">
        <h2 class="text-base-content/45 flex items-center gap-2 text-xs font-semibold tracking-widest uppercase">
          <span class="bg-primary/60 h-px w-6" /> Education
        </h2>
        <div class="mt-5 space-y-4">
          {education.map(e => (
            <div class="flex flex-wrap items-baseline justify-between gap-x-3">
              <div>
                <h3 class="text-base-content font-medium">{e.program}</h3>
                <p class="text-base-content/55 text-sm">
                  {e.school}
                  {e.location ? ` · ${e.location}` : ""}
                </p>
              </div>
              <span class="text-base-content/45 text-sm whitespace-nowrap">{formatRange(e.start, e.end)}</span>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Research experience -->
  {
    research.length > 0 && (
      <section class="mt-12">
        <h2 class="text-base-content/45 flex items-center gap-2 text-xs font-semibold tracking-widest uppercase">
          <span class="bg-primary/60 h-px w-6" /> Research Experience
        </h2>
        <div class="mt-5 space-y-6">
          {research.map(r => (
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                <h3 class="text-base-content font-medium">
                  {r.role} <span class="text-base-content/50">· {r.organization}</span>
                </h3>
                <span class="text-base-content/45 text-sm whitespace-nowrap">{formatRange(r.start, r.end)}</span>
              </div>
              {r.location && <p class="text-base-content/40 mt-0.5 text-sm">{r.location}</p>}
              {r.highlights?.length ? (
                <ul class="text-base-content/70 mt-2 space-y-1.5 text-sm leading-6">
                  {r.highlights.map(h => (
                    <li class="flex gap-2">
                      <span class="bg-base-content/30 mt-2.5 h-1 w-1 shrink-0 rounded-full" />
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
              ) : null}
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Publications -->
  {
    publications.length > 0 && (
      <section class="mt-12">
        <h2 class="text-base-content/45 flex items-center gap-2 text-xs font-semibold tracking-widest uppercase">
          <span class="bg-primary/60 h-px w-6" /> Publications
        </h2>
        <div class="mt-6 space-y-5">
          {publications.map(p => {
            const [before, self, after] = splitAuthors(p);
            const href = pubHref(p);
            return (
              <div class="border-base-300/40 border-l pl-4">
                <h3 class="text-base-content text-sm font-medium">{p.title}</h3>
                <p class="text-base-content/55 mt-1 text-xs leading-5">
                  {before}
                  {self && <span class="text-base-content/85 font-semibold">{self}</span>}
                  {after}
                </p>
                <p class="text-base-content/45 mt-1 text-xs">
                  {p.venue} · {p.year}
                  {p.note ? ` · ${p.note}` : ""}
                </p>
                {href && (
                  <a href={href} target="_blank" rel="noreferrer" class="text-primary mt-1 inline-block text-xs hover:underline">
                    {p.doi ? `doi.org/${p.doi}` : "View"}
                  </a>
                )}
              </div>
            );
          })}
        </div>
      </section>
    )
  }

  <!-- Presentations -->
  {
    presentations.length > 0 && (
      <section class="mt-12">
        <h2 class="text-base-content/45 flex items-center gap-2 text-xs font-semibold tracking-widest uppercase">
          <span class="bg-primary/60 h-px w-6" /> Presentations
        </h2>
        <div class="mt-5 space-y-3">
          {presentations.map(p => (
            <div class="flex flex-wrap items-baseline justify-between gap-x-3">
              <div>
                <h3 class="text-base-content text-sm font-medium">{p.title}</h3>
                <p class="text-base-content/55 text-sm">
                  {p.event}
                  {p.location ? ` · ${p.location}` : ""}
                </p>
              </div>
              <span class="text-base-content/45 text-sm whitespace-nowrap">{p.date}</span>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Teaching experience -->
  {
    teaching.length > 0 && (
      <section class="mt-12">
        <h2 class="text-base-content/45 flex items-center gap-2 text-xs font-semibold tracking-widest uppercase">
          <span class="bg-primary/60 h-px w-6" /> Teaching Experience
        </h2>
        <div class="mt-5 space-y-4">
          {teaching.map(t => (
            <div class="flex flex-wrap items-baseline justify-between gap-x-3">
              <div>
                <h3 class="text-base-content font-medium">
                  {t.role}
                  {t.course ? ` — ${t.course}` : ""}
                </h3>
                <p class="text-base-content/55 text-sm">{t.institution}</p>
              </div>
              <span class="text-base-content/45 text-sm whitespace-nowrap">{formatRange(t.start, t.end)}</span>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Awards and grants -->
  {
    awards.length > 0 && (
      <section class="mt-12">
        <h2 class="text-base-content/45 flex items-center gap-2 text-xs font-semibold tracking-widest uppercase">
          <span class="bg-primary/60 h-px w-6" /> Awards & Grants
        </h2>
        <div class="mt-5 space-y-2">
          {awards.map(a => (
            <div class="flex flex-wrap items-baseline justify-between gap-x-3">
              <p class="text-base-content/80 text-sm">
                <span class="text-base-content font-medium">{a.name}</span>
                {a.issuer ? ` · ${a.issuer}` : ""}
                {a.amount ? ` · ${a.amount}` : ""}
              </p>
              <span class="text-base-content/45 text-sm">{a.year}</span>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Certifications -->
  {
    certifications.length > 0 && (
      <section class="mt-12">
        <h2 class="text-base-content/45 flex items-center gap-2 text-xs font-semibold tracking-widest uppercase">
          <span class="bg-primary/60 h-px w-6" /> Certifications
        </h2>
        <div class="mt-5 space-y-2">
          {certifications.map(c => (
            <div class="flex flex-wrap items-baseline justify-between gap-x-3">
              <p class="text-base-content/80 text-sm">
                <span class="text-base-content font-medium">{c.name}</span>
                {c.issuer ? ` · ${c.issuer}` : ""}
              </p>
              {c.year && <span class="text-base-content/45 text-sm">{c.year}</span>}
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Professional memberships -->
  {
    memberships.length > 0 && (
      <section class="mt-12">
        <h2 class="text-base-content/45 flex items-center gap-2 text-xs font-semibold tracking-widest uppercase">
          <span class="bg-primary/60 h-px w-6" /> Professional Memberships
        </h2>
        <div class="mt-5 space-y-2">
          {memberships.map(m => (
            <div class="flex flex-wrap items-baseline justify-between gap-x-3">
              <p class="text-base-content/80 text-sm">
                <span class="text-base-content font-medium">{m.organization}</span>
                {m.role ? ` · ${m.role}` : ""}
              </p>
              {m.since && <span class="text-base-content/45 text-sm">since {m.since}</span>}
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- Skills -->
  {
    skillLines.length > 0 && (
      <section class="mt-12">
        <h2 class="text-base-content/45 flex items-center gap-2 text-xs font-semibold tracking-widest uppercase">
          <span class="bg-primary/60 h-px w-6" /> Skills
        </h2>
        <div class="mt-5 space-y-4">
          {skillLines.map(s => (
            <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline">
              <span class="text-base-content/45 w-36 shrink-0 text-xs tracking-wide uppercase">{s.label}</span>
              <div class="flex flex-wrap gap-1.5">
                {s.items.map(item => (
                  <span
                    data-roles={rolesAttr(item.roles)}
                    class="border-base-300/50 text-base-content/70 rounded-full border px-2.5 py-0.5 text-xs"
                  >
                    {item.name}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <!-- References -->
  <section class="mt-12">
    <h2 class="text-base-content/45 flex items-center gap-2 text-xs font-semibold tracking-widest uppercase">
      <span class="bg-primary/60 h-px w-6" /> References
    </h2>
    {
      references.length > 0 ? (
        <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {references.map(r => (
            <div>
              <p class="text-base-content text-sm font-medium">{r.name}</p>
              {(r.title || r.affiliation) && (
                <p class="text-base-content/55 text-sm">{[r.title, r.affiliation].filter(Boolean).join(", ")}</p>
              )}
              {r.email && (
                <a href={`mailto:${r.email}`} class="text-primary text-xs hover:underline">
                  {r.email}
                </a>
              )}
            </div>
          ))}
        </div>
      ) : (
        <p class="text-base-content/55 mt-4 text-sm">Available upon request.</p>
      )
    }
  </section>
</main>
