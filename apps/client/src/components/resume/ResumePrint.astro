---
import { portfolio } from "@portfolio/data";
import { formatRange } from "../../utils/formatDate";
import { getContacts, getSkillLines, getPrintProjects } from "../../utils/resume";

const { basics, summary, experience = [], skills, education = [], languages = [] } = portfolio;
const contacts = getContacts(basics);
const skillLines = getSkillLines(skills);
const printProjects = getPrintProjects(portfolio.projects ?? []);
---

<!-- Jake-style single-column ATS document (print only) -->
<article class="resume-print hidden bg-white print:block">
  <!-- Header -->
  <header>
    <h1 class="resume-name">{basics.fullName}</h1>
    <p class="font-bold">{basics.title}</p>
    <p class="mt-1">
      {
        contacts.map((c, i) => (
          <>
            {i > 0 && <span class="mx-1.5 text-black/40">|</span>}
            <a href={c.href}>{c.text}</a>
          </>
        ))
      }
    </p>
  </header>

  {
    summary?.lines?.length && (
      <section class="mt-3">
        <h2 class="resume-h2">Summary</h2>
        {summary.lines.map(line => (
          <p class="entry">{line}</p>
        ))}
      </section>
    )
  }

  {
    skillLines.length && (
      <section class="mt-3">
        <h2 class="resume-h2">Skills</h2>
        <div class="space-y-0.5">
          {skillLines.map(s => (
            <p class="entry">
              <span class="font-bold">{s.label}</span>: {s.items.join(", ")}
            </p>
          ))}
        </div>
      </section>
    )
  }

  {
    experience.length && (
      <section class="mt-3">
        <h2 class="resume-h2">Work Experience</h2>
        <div class="space-y-2">
          {experience.map(role => (
            <div class="entry">
              <div class="flex items-baseline justify-between gap-4">
                <span class="font-bold">{role.role}</span>
                <span class="whitespace-nowrap">{formatRange(role.start, role.end)}</span>
              </div>
              <div class="flex items-baseline justify-between gap-4 italic">
                <span>{role.company}</span>
                {role.location && <span class="whitespace-nowrap">{role.location}</span>}
              </div>
              {role.highlights?.length ? (
                <ul class="resume-bullets">
                  {role.highlights.map(h => (
                    <li>{h}</li>
                  ))}
                </ul>
              ) : null}
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    printProjects.length && (
      <section class="mt-3">
        <h2 class="resume-h2">Projects</h2>
        <div class="space-y-2">
          {printProjects.map(p => (
            <div class="entry">
              <div class="flex items-baseline justify-between gap-4">
                <span class="font-bold">{p.name}</span>
                {p.start && <span class="whitespace-nowrap">{formatRange(p.start, p.end ?? "Present")}</span>}
              </div>
              {p.tagline && <p>{p.tagline}</p>}
              {p.highlights?.length ? (
                <ul class="resume-bullets">
                  {p.highlights.map(h => (
                    <li>{h}</li>
                  ))}
                </ul>
              ) : null}
              {p.stack?.length ? <p class="mt-0.5">Stack: {p.stack.join(", ")}</p> : null}
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    education.length && (
      <section class="mt-3">
        <h2 class="resume-h2">Education</h2>
        <div class="space-y-2">
          {education.map(e => (
            <div class="entry">
              <div class="flex items-baseline justify-between gap-4">
                <span class="font-bold">{e.school}</span>
                {e.location && <span class="whitespace-nowrap">{e.location}</span>}
              </div>
              <div class="flex items-baseline justify-between gap-4 italic">
                <span>{e.program}</span>
                <span class="whitespace-nowrap">{formatRange(e.start, e.end)}</span>
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    languages.length && (
      <section class="mt-3">
        <h2 class="resume-h2">Languages</h2>
        <p class="entry">{languages.map(l => `${l.name} (${l.level})`).join("  ·  ")}</p>
      </section>
    )
  }
</article>
